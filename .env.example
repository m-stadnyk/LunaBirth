# Supabase — Cloud Sync (optional)
# Create a free project at https://supabase.com, then copy these values
# from Project Settings → API.
#
# Leave blank to run in local-only mode (no cloud sync).

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Feedback (optional)
# Address for the "Send feedback by email" link in Settings. Set it in Netlify →
# Site configuration → Environment variables. Leave blank to hide the link.
VITE_FEEDBACK_EMAIL=
